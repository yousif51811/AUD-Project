DATABASE_URL=postgresql://familymind:familymind_local@127.0.0.1:5433/familymind
DATABASE_URL_UNPOOLED=postgresql://familymind:familymind_local@127.0.0.1:5433/familymind
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000

# Optional Google sign-in (server only; never prefix with NEXT_PUBLIC_).
# Register APP_URL/api/auth/callback/google as a Web application redirect URI.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Shared Gemini, default for accounts and the fictional demo (server only).
# Put the real key in private local/Render environment settings, never in source/chat.
# GEMINI_API_KEY=your-private-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional lower shared allowances; values above these defaults are capped.
AI_CALLER_RPM=5
AI_GLOBAL_RPM=10
AI_GLOBAL_RPD=100
