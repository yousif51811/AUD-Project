{
  "name": "familymind-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FamilyMind AI - privacy-conscious, explainable family wellbeing prototype",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "prisma generate && next build --webpack",
    "preview": "next start --hostname 127.0.0.1 --port 4173",
    "test": "vitest run",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src --max-warnings=0",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:local": "node --import tsx scripts/local-postgres.ts",
    "test:e2e": "node scripts/testing.mjs browser",
    "test:integration": "node scripts/testing.mjs integration",
    "postinstall": "prisma generate",
    "test:server": "node scripts/testing.mjs server",
    "verify:neon": "node --import tsx scripts/verify-neon.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "better-auth": "^1.7.13",
    "libsodium-wrappers-sumo": "^0.8.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@neon/config": "^1.9.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.4",
    "pg": "8.20.0",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
